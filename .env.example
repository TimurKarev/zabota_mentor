# Local environment template (Story 1.1c).
#
# Copy to `.env` and adjust: `cp .env.example .env`
# `.env` is gitignored — placeholders only, never real secrets.
# In production secrets live in Yandex Lockbox (AD-5), not in files.

# HTTP server (src/app/__main__.py; compose overrides to 0.0.0.0 inside the container)
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL 17 — host-machine view of the compose `postgres` service.
# Used by migrations (`python -m src.adapters.db.migrate`) and future app wiring.
# Defaults match docker-compose.yml throwaway dev credentials.
POSTGRES_DB=zabota
POSTGRES_USER=zabota
POSTGRES_PASSWORD=zabota
DATABASE_URL=postgres://zabota:zabota@localhost:5432/zabota

# DB-backed contract tests (tests/contract/*); without it they skip.
# Points at the throwaway test DB (created by scripts/create-test-db.sh on a
# fresh compose volume — see its header for the existing-volume one-liner),
# NOT the persistent dev database above.
TEST_DATABASE_URL=postgres://zabota:zabota@localhost:5432/zabota_test

# Redis 8 (future — not wired until Story 1.6; AD-4: dedup/pacing only)
REDIS_URL=redis://localhost:6379/0

# Telegram bot (Story 1.2). Token from @BotFather; placeholder only here —
# in production secrets live in Yandex Lockbox (AD-5), never in files.
# Without BOT_TOKEN the app serves /health only (no bot).
BOT_TOKEN=

# Bot transport: `polling` (dev default — no public URL needed) or `webhook`
# (prod — needs WEBHOOK_URL + TELEGRAM_SECRET_TOKEN below).
BOT_MODE=polling

# Public base URL for webhook mode, prod only (e.g. https://mentor.example.com).
# The app registers <WEBHOOK_URL>/telegram/webhook with Telegram on startup.
WEBHOOK_URL=

# Shared secret for the webhook endpoint (X-Telegram-Bot-Api-Secret-Token).
# 1-256 chars of A-Za-z0-9_- ; generate e.g. `openssl rand -hex 32`.
TELEGRAM_SECRET_TOKEN=

# Bot API proxy (staging: RU networks block api.telegram.org). Routed through
# the `warp` SOCKS5 container in docker-compose.staging.yml; unset = direct.
# Any proxy URL works here (socks5://… or http://…) — swapping the transport
# never needs a code change.
TG_PROXY_URL=socks5://warp:1080
